# Backend (Railway) settings. Local: copy to apps/api/.env.local. Railway: service → Variables.
# Never commit real values.

# ── DevRev ──
DEVREV_TOKEN=
DEVREV_BASE_URL=
DEVREV_APP_URL=

# ── Claude (one of) ──
# ANTHROPIC_API_KEY: org API key.  CLAUDE_CODE_OAUTH_TOKEN: your Claude login for a server (`claude setup-token`).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# ── Postgres ──
# App role (data only). MIGRATION_DATABASE_URL = schema-owner role, if different (see db/roles.sql).
DATABASE_URL=
MIGRATION_DATABASE_URL=
# off (local Docker) | require | verify-full (+ DATABASE_CA_CERT=/path/to/ca.pem)
DATABASE_SSL=off
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# ── Ports & URLs (all optional — defaults shown; see src/lib/settings.ts) ──
# PORT=3000                              # server port (Render/Railway set this themselves; local npm run up: 3001)
# INTERNAL_URL=http://127.0.0.1:$PORT    # how the server's own tools reach it
# DEVREV_BASE_URL=https://api.devrev.ai
# DEVREV_APP_URL=https://app.devrev.ai
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# APP_LOG_CALLBACK_PORT=3334             # connector's local port for the app-logs sign-in
# DEV_RESOLVE_DB_PORT=5434               # local docker-compose Postgres port

# ── App ──
# The URL people open = the FRONTEND (Vercel), e.g. https://devresolve.example.com. Pins the allowed origin,
# Google redirect (<APP_URL>/api/auth/google/callback) and secure cookies.
APP_URL=
# The backend's own public URL (Railway) — laptop connectors connect here directly.
BACKEND_PUBLIC_URL=
# Logins are managed with `npm run user` (stored hashed in Postgres). DEV_RESOLVE_USERS (name:pw,…) is only
# imported once into an empty users table — remove it afterwards.
DEV_RESOLVE_USERS=
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# ── Sign in with Google (Dev Resolve's own login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# required: which Google domains may sign in (comma list)
GOOGLE_ALLOWED_DOMAINS=
# first-time setup only: these emails are added as admins if the user list is empty
GOOGLE_ADMIN_EMAILS=
# off = Google only (password logins hidden)
DEV_RESOLVE_PASSWORD_LOGIN=on

# ── Local connector (deployed server): VPN-only requests + Google sign-ins come from each person's laptop ──
DEV_RESOLVE_CONNECTOR=off

# ── Code the agent reads (synced from GitHub) ──
CODE_ROOT=
CODE_GIT_BASE=
CODE_GIT_BRANCH=main
# Fine-grained, read-only "Contents" on only the repos in projects.json code_repos
GITHUB_TOKEN=
