      "password_env": "RELIANCE_OS_PASSWORD",
      "log_types": {
        "reliance_app": "app-logs-*ril-vf*",
        "reliance_audit": "audit-logs-*-ril-vf-*",
        "reliance_link": "api-logger-logs-liink",
        "qc_app": "app-logs-*ril-qc-prod",
        "qc_audit": "audit-logs-*-ril-qc-prod",
        "qc_api": "api-logger-logs-ril-qc-liink-prod"
      }
    },
    "metabase": {
