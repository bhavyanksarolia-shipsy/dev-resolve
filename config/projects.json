      "password_env": "RELIANCE_METABASE_PASSWORD",
      "session_token_env": "RELIANCE_METABASE_SESSION_TOKEN",
      "default_database": 2,
      "databases": {
        "2": "Reliance VF Postgres (vf-replica-db) — default for this project",
        "3": "Reliance VF Mongo (vf-prod-mongodb)"
      }
    }
  },
