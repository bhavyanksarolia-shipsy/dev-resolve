  "devrev_view": {
    "_comment": "Mirrors DevRev's WMS 'Support' view (verified 2026-09-25: 125 org-wide, VF 33 — matched 19/19 workspaces). Counts + inbox use these rules. 'default_part_id' = the part new email tickets land on before triage.",
    "name": "DevRev WMS Support view",
    "subtype": "Support",
    "wms_product_id": "don:core:dvrv-us-1:devo/xXjPo9nF:product/23",
    "default_part_id": "don:core:dvrv-us-1:devo/xXjPo9nF:product/19",
    "default_part_label": "TMS (default, untriaged)",
    "stages": [
      "queued",
      "work_in_progress",
      "awaiting_development",
      "awaiting_customer_response",
      "Reopen",
      "Reassigned to Customer Support",
      "in_development",
      "awaiting_product_assist"
    ]
  },
  "wms": {
    "label": "Reliance VF + QC logs (vf-wms-os.ril.com); Reliance VF Metabase (vf-wms-metabase.ril.com)",
    "opensearch": {
      "url_env": "RELIANCE_OS_URL",
