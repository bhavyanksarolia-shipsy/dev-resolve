# Copy to config/config.env (gitignored) and fill in. Every endpoint, username, password, token and client id
# lives here — never in code. Names below match config/projects.example.json; use your own project prefixes.
# Passwords: prefer `npm run metabase-password -- <project>` (hidden input) over typing them in.

# OpenSearch (per connection project)
ACME_OS_URL=
ACME_OS_USERNAME=
ACME_OS_PASSWORD=

# Metabase — username/password login
ACME_METABASE_BASE_URL=
ACME_METABASE_USERNAME=
ACME_METABASE_PASSWORD=
ACME_METABASE_SESSION_TOKEN=

# Metabase — Google login (session renewed automatically)
SSO_METABASE_BASE_URL=
SSO_METABASE_SESSION_TOKEN=
SSO_ACCOUNT_DOMAIN=

# Application logs via MCP (mcp-remote)
APP_LOG_MCP_URL=
APP_LOG_OAUTH_CLIENT_INFO=
DASHBOARDS_URL=

# VPN detection / hint shown in "Connect VPN" banners
VPN_HOST_SUFFIXES=
VPN_HINT=

# Service/integration usernames the agent should recognise in audit logs (optional)
WMS_INTEGRATION_USER=
QC_INTEGRATION_USER=
