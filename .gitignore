# ── build / deps (both apps) ──
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.DS_Store
*.pem
npm-debug.log*
.vercel
__pycache__/

# ── env files: never commit (templates are fine) ──
.env*
!.env.example

# ── Backend private data (code-only repo) ──
apps/api/config/config.env
apps/api/config/projects.json
apps/api/config/metabase_ratelimit*.json
apps/api/config/.metabase-cache/
apps/api/config/welcome-email.json
apps/api/.auth/
apps/api/.logs/
apps/api/code/
apps/api/backups/
# Knowledge base content — only the README + empty template + shared folder are public
apps/api/knowledge/*
!apps/api/knowledge/README.md
!apps/api/knowledge/_template/
!apps/api/knowledge/_shared/
# Client-specific skills (uploaded in Admin → Connections → Claude; kept in the database) and ticket-digest lists
apps/api/.claude/skills/*
!apps/api/.claude/skills/metabase-sql/
apps/api/services/wms_ticket_digest/.env
apps/api/services/wms_ticket_digest/state/
apps/api/services/wms_ticket_digest/config/*.json
!apps/api/services/wms_ticket_digest/config/*.example.json

# knowledge archive made for upload (npm run pack-knowledge)
knowledge-upload.tgz
# Chrome Web Store upload package (npm run extension:package)
dev-resolve-extension-*.zip
