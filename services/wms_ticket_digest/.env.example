# Copy this file to .env and fill in real values. Never commit .env.
# The token that was previously hardcoded in the n8n workflow's HTTP Request
# nodes should be treated as compromised (it was visible in plaintext in the
# UI) and ROTATED in DevRev before you put a new one here.

DEVREV_TOKEN=
DEVREV_BASE_URL=https://api.devrev.ai

SLACK_BOT_TOKEN=
# From the n8n workflow: production digest channel
SLACK_CHANNEL_PROD=C06AM1176H0
# From the n8n workflow: test/dry-run channel
SLACK_CHANNEL_TEST=C0A1EBMFLPQ
# Where failure alerts get posted. Leave blank to only log to stdout/stderr.
SLACK_OPS_ALERT_CHANNEL=

# Google Sheets export (leave GOOGLE_SHEET_ID blank to skip this step)
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
GOOGLE_SHEET_ID=13bQ9CqmBdGT9dcVdhYRbAqnEi26NEOzvK4Ag_Xr6Yrc
GOOGLE_SHEET_NAME=TICKETS_RAW

STATE_DB_PATH=./state/wms_digest.sqlite3

# Tuning (defaults shown, usually fine to leave unset)
# SLACK_MESSAGE_CHUNK_LIMIT=3500
# DEVREV_PAGE_LIMIT=100
